# Migration job file - the "one place" to set repo/folder path and tweak
# a run instead of typing flags every time.
#
# Copy this file to `migration.env` (gitignored - never committed) and fill
# in what you need. Anything left blank uses the default shown below. Any of
# these can still be overridden per-invocation the normal way, e.g.
# `ENV=int ./run.sh demo` - an explicit shell env var always wins over this
# file.
#
#   cp migration.env.example migration.env
#   ./run.sh migrate          # no path argument needed anymore

# --- Source repository ----------------------------------------------------
# A git URL (https or ssh) to clone, OR a local folder path (absolute, or
# relative to the repo root). Leave blank to fall back to ./ocp if that
# folder exists (drop/checkout your OCP repo there as a standing default).
REPO=

# Branch/tag to check out when REPO is a git URL. Blank = repo default branch.
REPO_BRANCH=

# --- Target ----------------------------------------------------------------
# Environment name from config/env-matrix.yaml.
ENV=dev

# offline | assisted | connected - cluster connectivity for VALIDATE
# (dry-run/RBAC checks). Does NOT gate the LLM - the LLM runs every time,
# in every mode (see config/models.yaml).
MODE=offline

# --- Tweaks ------------------------------------------------------------
# true/false - whether a BLOCK verdict makes the run exit non-zero.
FAIL_ON_BLOCK=true

# Where migrated artefacts + reports are written (absolute, or relative to
# the repo root).
OUT_DIR=aks

# Point at an alternate config/ directory (custom standards.yaml,
# mappings.yaml, rules.yaml, models.yaml) without editing the tracked one.
CONFIG_DIR=config

# Default intake file for `./run.sh workbook` when no path is given.
WORKBOOK_INTAKE=migration-intake.example.txt

# --- LLM (mandatory) --------------------------------------------------------
# Every run calls an LLM to review and update the migrated files - see
# config/models.yaml. Default provider is Ollama: local, no API key, no
# per-call cost - but the Ollama daemon must be running with the model
# pulled (`ollama pull llama3.1:8b`).
#
# From inside the container, "localhost" means the container itself, not
# your machine - leave this pointed at Docker Desktop's host gateway unless
# Ollama (or a hosted provider) runs somewhere else.
LLM_ENDPOINT=http://host.docker.internal:11434

# Override the model tag from config/models.yaml, e.g. for a faster/smaller
# local model while iterating: LLM_MODEL=qwen2.5:1.5b
LLM_MODEL=

# Sampling seed, for determinism (provider-dependent).
LLM_SEED=

# Per-file call timeout in seconds (default: 600). A file that times out
# never aborts the run - its deterministic output is kept and it's recorded
# as finding L4. Raise this - or set LLM_MODEL to something smaller/faster -
# on slower/CPU-only/VDI hardware where a larger model may not finish a
# single file's generation within the default window.
LLM_TIMEOUT=

# --- Idempotency / freeze ---------------------------------------------
# false (default): the LLM runs fresh every time - use this while you're
#       still iterating on the result.
# true: once a response has been generated and cached for a given file +
#       exact same inputs, it is replayed verbatim instead of calling the
#       model again - guaranteeing byte-identical output run after run.
#
# Workflow: run with FREEZE_OUTPUT=false (or unset) until you're happy with
# the migrated output, then flip this to true. The *next* run - and every
# run after it, as long as the inputs don't change - reproduces exactly
# what you just confirmed.
FREEZE_OUTPUT=false

# Force a fresh LLM call even if FREEZE_OUTPUT=true and a cached response
# exists (use once, to intentionally regenerate, then set this back to
# false and re-freeze once you like the new result).
LLM_FORCE_REFRESH=false

# Where frozen/cached LLM responses are stored. Left blank, this defaults
# to <OUT_DIR>/.llm_cache, so it persists across runs the same way the
# rest of OUT_DIR does.
LLM_CACHE_DIR=
